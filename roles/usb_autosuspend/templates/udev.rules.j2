# Keep these RTL9201R USB bridges powered and stable because their
# autosuspend events trigger resets that cut storage links.
#
# Split the two writes into separate rules: if a kernel lacks
# power/autosuspend_delay_ms, the control=on assignment must still apply.
{% for vid_pid in usb_autosuspend_vendors %}
{% set vid = vid_pid.split(':')[0] %}
{% set pid = vid_pid.split(':')[1] %}
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="{{ vid }}", ATTR{idProduct}=="{{ pid }}", ATTR{power/control}="{{ usb_autosuspend_power_control }}"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="{{ vid }}", ATTR{idProduct}=="{{ pid }}", ATTR{power/autosuspend_delay_ms}="{{ usb_autosuspend_delay_ms }}"
{% endfor %}
