#!/usr/bin/env python3
"""
Update USB hostdev <address bus=… device=…> entries in a libvirt VM XML
to match the current enumeration reported by lsusb.

Run as root before starting the VM. Usage: update-xml-addresses.py <vm-name>

Strategy: use `virsh detach-device --config` / `virsh attach-device --config`
instead of rewriting the whole XML, to avoid losing namespaces or other
elements that ET.tostring() may silently drop.
"""
import sys
import subprocess
import re
import tempfile
import os
import xml.etree.ElementTree as ET


def lsusb_devices():
    """Return list of (bus, device, vendor, product) from lsusb output."""
    out = subprocess.check_output(["lsusb"], text=True)
    devices = []
    for line in out.splitlines():
        m = re.match(r"Bus (\d+) Device (\d+): ID ([0-9a-f]{4}):([0-9a-f]{4})", line, re.I)
        if m:
            devices.append((int(m.group(1)), int(m.group(2)),
                            m.group(3).lower(), m.group(4).lower()))
    return devices


def xml_for_hostdev(vid, pid, bus, dev, usb_port):
    """Return a minimal hostdev XML fragment."""
    return (
        f'<hostdev mode="subsystem" type="usb" managed="yes">\n'
        f'  <source>\n'
        f'    <vendor id="0x{vid}"/>\n'
        f'    <product id="0x{pid}"/>\n'
        f'    <address bus="{bus}" device="{dev}"/>\n'
        f'  </source>\n'
        f'  <address type="usb" bus="0" port="{usb_port}"/>\n'
        f'</hostdev>\n'
    )


vm = sys.argv[1]

xml_bytes = subprocess.check_output(["virsh", "dumpxml", "--inactive", vm])
root = ET.fromstring(xml_bytes.decode())

all_lsusb = lsusb_devices()
changed = False

# Group hostdevs by (vid, pid)
hostdev_groups: dict[tuple, list] = {}
for hd in root.findall('.//hostdev[@type="usb"]'):
    src = hd.find("source")
    if src is None:
        continue
    v_el = src.find("vendor")
    p_el = src.find("product")
    if v_el is None or p_el is None:
        continue
    vid = v_el.get("id", "").replace("0x", "").lower().zfill(4)
    pid = p_el.get("id", "").replace("0x", "").lower().zfill(4)
    addr_el = src.find("address")
    cur_bus = int(addr_el.get("bus", -1)) if addr_el is not None else -1
    cur_dev = int(addr_el.get("device", -1)) if addr_el is not None else -1
    # usb port inside the VM (host-side address, not source)
    hd_addr = hd.find("address[@type='usb']")
    usb_port = hd_addr.get("port", "2") if hd_addr is not None else "2"
    hostdev_groups.setdefault((vid, pid), []).append({
        "hd": hd, "src": src, "cur_bus": cur_bus, "cur_dev": cur_dev,
        "usb_port": usb_port,
    })

for (vid, pid), entries in hostdev_groups.items():
    live = [(bus, dev) for (bus, dev, v, p) in all_lsusb
            if v == vid and p == pid]

    if len(live) < len(entries):
        print(f"WARNING: need {len(entries)} devices for {vid}:{pid}, "
              f"only {len(live)} visible via lsusb", file=sys.stderr)

    for i, entry in enumerate(entries):
        if i >= len(live):
            break
        new_bus, new_dev = live[i]
        if entry["cur_bus"] == new_bus and entry["cur_dev"] == new_dev:
            continue  # already correct

        # Detach old definition, attach new one
        old_xml = xml_for_hostdev(vid, pid, entry["cur_bus"], entry["cur_dev"],
                                  entry["usb_port"])
        new_xml = xml_for_hostdev(vid, pid, new_bus, new_dev, entry["usb_port"])

        for xml_str, action in [(old_xml, "detach-device"), (new_xml, "attach-device")]:
            tmp = tempfile.NamedTemporaryFile(suffix=".xml", delete=False, mode="w")
            tmp.write(xml_str)
            tmp.close()
            try:
                subprocess.check_call(
                    ["virsh", action, "--config", vm, tmp.name],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except subprocess.CalledProcessError as e:
                # detach may fail if address was already wrong/missing — continue
                if action == "detach-device":
                    print(f"WARNING: detach failed for {vid}:{pid} entry {i} "
                          f"(bus={entry['cur_bus']} dev={entry['cur_dev']}), "
                          f"trying attach anyway", file=sys.stderr)
                else:
                    raise
            finally:
                os.unlink(tmp.name)

        print(f"Updated {vid}:{pid} entry {i}: "
              f"bus {entry['cur_bus']}→{new_bus} device {entry['cur_dev']}→{new_dev}")
        changed = True

print("changed" if changed else "ok")
