# Environment file for libvirt-usb-hotstart@{{ libvirt_usb_hotstart_vm }}.service
# Generated by Ansible — do not edit by hand.
#
# Space-separated list of "vendor:product:count" triplets.
# The script waits until each VID:PID appears at least <count> times in sysfs.
USB_DEVICES="{{ libvirt_usb_hotstart_devices | map(attribute='vendor') | zip(libvirt_usb_hotstart_devices | map(attribute='product'), libvirt_usb_hotstart_devices | map(attribute='count') | map('string')) | map('join', ':') | join(' ') }}"
WAIT_TIMEOUT="{{ libvirt_usb_hotstart_timeout }}"
