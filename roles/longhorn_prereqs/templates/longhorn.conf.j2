# Managed by Ansible -- roles/longhorn_prereqs/templates/longhorn.conf.j2
#
# systemd-modules-load.service reads every *.conf file in this directory at
# boot and modprobes one module per line. That is how these modules survive a
# reboot: loading them in the running kernel only lasts until the next boot.
#
# This file is separate from the kernel_modules role's k3s.conf on purpose.
# iscsi_tcp and dm_crypt are not k3s requirements -- they are Longhorn
# requirements -- and the kernel_modules role deliberately left them out so
# that they would live here, in the role that can explain why they exist.
#
# Do not edit this file by hand. The next run of site.yml overwrites it.
{% for longhorn_module in longhorn_modules_to_load %}
{{ longhorn_module }}
{% endfor %}
